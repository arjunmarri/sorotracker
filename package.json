{
  "name": "sorotrack",
  "version": "2.0.0",
  "private": true,
  "description": "Browser extension: a private page assistant powered by a local LLM (Ollama or any OpenAI-compatible server).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "package": "node scripts/build.mjs --zip",
    "downloads": "node scripts/build.mjs --downloads",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test \"test/*.test.mjs\""
  }
}
