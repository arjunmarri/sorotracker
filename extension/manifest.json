{
  "manifest_version": 3,
  "name": "SoroTrack — AI Page Assistant",
  "short_name": "SoroTrack",
  "version": "2.1.1",
  "description": "A page assistant powered by your local LLM (Ollama, LM Studio…) or your own API key (Claude, OpenAI, Gemini…). Summarize pages, save snippets, remove AI slop.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "scripting", "activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/sw.js",
    "scripts": ["shared/config.js", "shared/markdown.js", "background/llm.js", "background/secrets.js", "background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "shared/config.js",
        "shared/markdown.js",
        "shared/prompts.js",
        "shared/snippets.js",
        "content/extract.js",
        "content/styles.js",
        "content/assistant.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SoroTrack",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-assistant": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Open or close the assistant on the current page"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sorotrack@arjunmarri.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
